# ============================================
# SUPABASE (obrigatório)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://nxcpzdhqsipcrcukiwib.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_EIB6JXLMeLA0Cfd51emShQ_0SoJSX3t
# Chave de serviço: NUNCA expor no frontend. Usada apenas em rotas server-side (API routes / server actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# OAUTH PROVIDERS (configurados também no painel do Supabase Auth)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ============================================
# PROVEDORES DE IA (opcionais — o usuário configura os que for usar)
# As chaves reais dos usuários finais ficam criptografadas na tabela `ai_provider_keys`,
# nunca em variáveis de ambiente do servidor compartilhado. Estas aqui são chaves
# "default"/fallback opcionais do próprio dono da instância.
# ============================================
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ============================================
# CRIPTOGRAFIA
# ============================================
# Usada para criptografar/descriptografar as API keys dos usuários antes de salvar no banco (AES-256-GCM).
# Gere com: openssl rand -base64 32
AI_KEYS_ENCRYPTION_SECRET=vdFiwPj45tVhapi3avnwLu5R8TOVBESXiN/3YjA4zX8


# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Scan Studio

# ============================================
# FILA / PROCESSAMENTO (opcional em produção real)
# Se usar um worker externo (ex: fila baseada em Supabase Edge Functions + cron,
# ou um serviço externo tipo Upstash QStash / Inngest) configure aqui.
# ============================================
QUEUE_PROVIDER=supabase # supabase | inngest | qstash
INNGEST_EVENT_KEY=
QSTASH_TOKEN=

# ============================================
# LIMITES
# ============================================
MAX_UPLOAD_SIZE_MB=200
MAX_PAGES_PER_CHAPTER=500
